{
  "manifest_version": 3,
  "name": "ChatSave: AI Chat Exporter — ChatGPT, Claude, Gemini to PDF, Word, Markdown",
  "short_name": "ChatSave",
  "version": "1.0.2",
  "description": "Export ChatGPT, Claude, Gemini, Grok, DeepSeek & more to PDF, Word, Markdown, Notion. Free, no account, nothing leaves your browser.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "identity",
    "downloads",
    "clipboardRead"
  ],
  "host_permissions": [
    "https://fylo.host/*",
    "https://api.notion.com/*"
  ],
  "background": {
    "service_worker": "src/bg/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "ChatSave"
  },
  "content_scripts": [
    {
      "matches": [
        "https://aistudio.google.com/*",
        "https://chat.deepseek.com/*",
        "https://chat.openai.com/*",
        "https://chat.qwen.ai/*",
        "https://chat.qwenlm.ai/*",
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://copilot.microsoft.com/*",
        "https://doubao.com/*",
        "https://gemini.google.com/*",
        "https://github.com/copilot*",
        "https://grok.com/*",
        "https://kimi.ai/*",
        "https://kimi.com/*",
        "https://kimi.moonshot.cn/*",
        "https://m365.cloud.microsoft/*",
        "https://notebook.google.com/*",
        "https://notebooklm.google.com/*",
        "https://perplexity.ai/*",
        "https://tongyi.aliyun.com/*",
        "https://www.doubao.com/*",
        "https://www.kimi.ai/*",
        "https://www.kimi.com/*",
        "https://www.perplexity.ai/*",
        "https://www.qianwen.com/*",
        "https://x.com/i/grok*",
        "https://yuanbao.tencent.com/*"
      ],
      "js": [
        "src/shared/model.js",
        "src/shared/selectors.js",
        "src/export/inline.js",
        "src/export/markdown.js",
        "src/export/text.js",
        "src/export/json.js",
        "src/export/html.js",
        "src/export/docx.js",
        "src/export/download.js",
        "src/content/parser.js",
        "src/content/ui.js",
        "src/content/main.js"
      ],
      "css": [
        "src/content/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/print/print.html"
      ],
      "matches": [
        "https://aistudio.google.com/*",
        "https://chat.deepseek.com/*",
        "https://chat.openai.com/*",
        "https://chat.qwen.ai/*",
        "https://chat.qwenlm.ai/*",
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://copilot.microsoft.com/*",
        "https://doubao.com/*",
        "https://gemini.google.com/*",
        "https://github.com/*",
        "https://grok.com/*",
        "https://kimi.ai/*",
        "https://kimi.com/*",
        "https://kimi.moonshot.cn/*",
        "https://m365.cloud.microsoft/*",
        "https://notebook.google.com/*",
        "https://notebooklm.google.com/*",
        "https://perplexity.ai/*",
        "https://tongyi.aliyun.com/*",
        "https://www.doubao.com/*",
        "https://www.kimi.ai/*",
        "https://www.kimi.com/*",
        "https://www.perplexity.ai/*",
        "https://www.qianwen.com/*",
        "https://x.com/*",
        "https://yuanbao.tencent.com/*"
      ]
    }
  ],
  "homepage_url": "https://chatsave.app",
  "author": "ChatSave"
}
